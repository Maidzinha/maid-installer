<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MaidInstaller.AI</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- llama.cpp para .NET. Só o backend de CPU: funciona em qualquer PC (e no pendrive) sem drivers extras. -->
    <PackageReference Include="LLamaSharp" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.30.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MaidInstaller.Core\MaidInstaller.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MaidInstaller.Core.Tests" />
  </ItemGroup>
</Project>
