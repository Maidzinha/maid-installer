<Window x:Class="MaidInstaller.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MaidInstaller.App.Localization"
        xmlns:vm="clr-namespace:MaidInstaller.App.ViewModels"
        xmlns:views="clr-namespace:MaidInstaller.App.Views"
        Title="{loc:T 'Maid Installer — Personal Edition'}"
        Width="1360" Height="820" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" Icon="Assets/icon.ico"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}"><views:PlaceholderView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}"><views:AboutView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}"><views:LibraryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstallsViewModel}"><views:InstallsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CollectionsViewModel}"><views:CollectionsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PostFormatViewModel}"><views:PostFormatView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UpdatesViewModel}"><views:UpdatesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- Fundo: preto profundo com brilhos rosa discretos -->
        <Grid IsHitTestVisible="False">
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.42,0.35" GradientOrigin="0.42,0.35" RadiusX="0.55" RadiusY="0.7">
                        <GradientStop Color="{StaticResource C_FF2A0E1C}" Offset="0" />
                        <GradientStop Color="{StaticResource C_FF12070D}" Offset="0.6" />
                        <GradientStop Color="{StaticResource C_FF0A0608}" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-160,-220" Opacity="0.35">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{StaticResource C_AAFF3E95}" Offset="0" />
                        <GradientStop Color="{StaticResource C_00FF3E95}" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Sakuras -->
            <Image Source="{StaticResource SakuraFlower}" Width="46" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,170,0" Opacity="0.45" />
            <Image Source="{StaticResource SakuraFlower}" Width="28" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,36,226,0" Opacity="0.3" />
            <Image Source="{StaticResource SakuraFlower}" Width="38" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,120" Opacity="0.35" />
            <Image Source="{StaticResource SakuraFlower}" Width="52" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,20" Opacity="0.45" />
            <Image Source="{StaticResource SakuraFlower}" Width="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,110,60" Opacity="0.3" />
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Barra lateral ============ -->
            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource B_33FF4FA3}" BorderThickness="0,0,1,0">
                <Grid Margin="16,18,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="4,0,0,28">
                        <Image Source="/Assets/logo.png" Width="58" Height="58" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Maid Installer" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text=" ♡" FontSize="20" Foreground="{StaticResource PinkNeonBrush}" />
                            </StackPanel>
                            <TextBlock Text="{loc:T 'Personal Edition'}" FontSize="13" Foreground="{StaticResource TextDimBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                             ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Once" />

                    <StackPanel Grid.Row="2" Margin="6,0,0,0">
                        <!-- Indicador da fila: abre a tela de instalações -->
                        <Button Style="{StaticResource GhostButton}" Margin="-6,0,0,14" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding ShowInstallsCommand}" ToolTip="{loc:T 'Ver instalações'}"
                                Visibility="{Binding Installs.HasJobs, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource IconText}" FontSize="14" />
                                <TextBlock Text="{Binding Installs.SidebarText}" Margin="8,0,0,0" FontSize="13" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="♡" Foreground="{StaticResource PinkNeonBrush}" FontSize="14" />
                            <TextBlock Text="{Binding VersionText}" Margin="6,0,0,0" FontSize="13" Foreground="{StaticResource TextDimBrush}" />
                        </StackPanel>
                        <Border CornerRadius="10" Padding="10,5" HorizontalAlignment="Left" BorderThickness="1"
                                BorderBrush="{StaticResource BorderBrushPink}" Background="{StaticResource B_331E1117}" ToolTip="{Binding ModeTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE88E;" Style="{StaticResource IconText}" FontSize="13" />
                                <TextBlock Text="{Binding ModeText}" Margin="8,0,0,0" FontSize="13" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Conteúdo ============ -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" />

            <!-- Botões da janela -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0">
                <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{loc:T 'Minimizar'}" />
                <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="Maximize_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{loc:T 'Maximizar'}" />
                <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" Click="Close_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{loc:T 'Fechar'}" />
            </StackPanel>
        </Grid>

        <!-- ============ Tour de boas-vindas ============ -->
        <Grid Visibility="{Binding Tour, Converter={StaticResource NullToVis}}">
            <Rectangle Fill="{StaticResource B_B3050304}" Opacity="0.55" />
            <Border DataContext="{Binding Tour}" Style="{StaticResource GlassPanel}" Background="{StaticResource B_F2160C12}" Padding="24,20"
                    Width="580" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,48">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Ellipse Width="58" Height="58" VerticalAlignment="Top" Margin="0,2,16,0" Stroke="{StaticResource PinkNeonBrush}" StrokeThickness="2">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="/Assets/avatar.png" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Text}" Margin="0,6,0,0" FontSize="14" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,18,0,0">
                        <TextBlock Text="{Binding StepText}" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextDimBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}" Content="{loc:T 'Pular tour'}" Command="{Binding SkipCommand}" Margin="0,0,10,0"
                                    IsCancel="True" Visibility="{Binding IsLast, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                            <Button Style="{StaticResource GhostButton}" Content="{loc:T 'Voltar'}" Command="{Binding BackCommand}" Margin="0,0,10,0"
                                    Visibility="{Binding IsFirst, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                            <Button Style="{StaticResource AccentButton}" Content="{Binding NextText}" Command="{Binding NextCommand}" IsDefault="True" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Diálogo de confirmação ============ -->
        <Grid Visibility="{Binding Dialog, Converter={StaticResource NullToVis}}" Background="{StaticResource B_B3050304}">
            <Border DataContext="{Binding Dialog}" Style="{StaticResource GlassPanel}" Background="{StaticResource B_F2160C12}" Padding="28,24"
                    Width="560" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Message}" Margin="0,8,0,12" FontSize="14" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="12,8" Margin="0,0,0,6" Background="{StaticResource B_22FF4FA3}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource TextDimBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Notes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="♡" Foreground="{StaticResource PinkNeonBrush}" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="{Binding CancelText}" Command="{Binding CancelCommand}" Margin="0,0,10,0"
                                IsCancel="True" Visibility="{Binding HasCancel, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource AccentButton}" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
