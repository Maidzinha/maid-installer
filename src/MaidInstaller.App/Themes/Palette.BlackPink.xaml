<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ MAID INSTALLER — TEMA PRETO E ROSA ♡ ============ -->

    <!-- Paleta -->
    <Color x:Key="BgColor">#FF0A0608</Color>
    <Color x:Key="Bg2Color">#FF150A10</Color>
    <Color x:Key="CardColor">#C21A1116</Color>
    <Color x:Key="PinkNeonColor">#FFFF4FA3</Color>
    <Color x:Key="PinkHotColor">#FFFF2E8C</Color>
    <Color x:Key="PinkPastelColor">#FFF7A8CC</Color>
    <Color x:Key="TextColor">#FFFBEFF4</Color>
    <Color x:Key="TextDimColor">#FFC4A6B4</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="PinkNeonBrush" Color="{StaticResource PinkNeonColor}" />
    <SolidColorBrush x:Key="PinkPastelBrush" Color="{StaticResource PinkPastelColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="BorderBrushPink" Color="#66FF4FA3" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#33FF7DBA" />
    <SolidColorBrush x:Key="TrackBrush" Color="#33FFFFFF" />

    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2120A0E" Offset="0" />
        <GradientStop Color="#F20D070A" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NeonGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFF5FAE" Offset="0" />
        <GradientStop Color="#FFE0287A" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CC22141B" Offset="0" />
        <GradientStop Color="#B3140C11" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ShortcutBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E62A1520" Offset="0" />
        <GradientStop Color="#E6190D13" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ShortcutHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F23D1A2C" Offset="0" />
        <GradientStop Color="#F2220F19" Offset="1" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="PinkGlow" Color="#FFFF4FA3" BlurRadius="22" ShadowDepth="0" Opacity="0.35" />
    <DropShadowEffect x:Key="PinkGlowStrong" Color="#FFFF4FA3" BlurRadius="26" ShadowDepth="0" Opacity="0.6" />
    <DropShadowEffect x:Key="TextGlow" Color="#FFFF4FA3" BlurRadius="14" ShadowDepth="0" Opacity="0.7" />

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Flor de sakura (decoração discreta) -->
    <DrawingImage x:Key="SakuraFlower">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.Children>
                    <GeometryDrawing Brush="#FFF06AA8" Geometry="M0,0 C-7,-8 -7,-19 0,-24 C7,-19 7,-8 0,0Z" />
                    <GeometryDrawing Brush="#FFF06AA8">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M0,0 C-7,-8 -7,-19 0,-24 C7,-19 7,-8 0,0Z">
                                <PathGeometry.Transform><RotateTransform Angle="72" /></PathGeometry.Transform>
                            </PathGeometry>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFF06AA8">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M0,0 C-7,-8 -7,-19 0,-24 C7,-19 7,-8 0,0Z">
                                <PathGeometry.Transform><RotateTransform Angle="144" /></PathGeometry.Transform>
                            </PathGeometry>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFF06AA8">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M0,0 C-7,-8 -7,-19 0,-24 C7,-19 7,-8 0,0Z">
                                <PathGeometry.Transform><RotateTransform Angle="216" /></PathGeometry.Transform>
                            </PathGeometry>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFF06AA8">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M0,0 C-7,-8 -7,-19 0,-24 C7,-19 7,-8 0,0Z">
                                <PathGeometry.Transform><RotateTransform Angle="288" /></PathGeometry.Transform>
                            </PathGeometry>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFFFD1E6">
                        <GeometryDrawing.Geometry><EllipseGeometry Center="0,0" RadiusX="4" RadiusY="4" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup.Children>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>


