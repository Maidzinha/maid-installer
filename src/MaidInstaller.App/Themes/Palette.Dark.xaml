<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ MAID INSTALLER — TEMA ESCURO ============ -->

    <!-- Paleta -->
    <Color x:Key="BgColor">#FF121316</Color>
    <Color x:Key="Bg2Color">#FF15171C</Color>
    <Color x:Key="CardColor">#C21A1B1F</Color>
    <Color x:Key="PinkNeonColor">#FF56A2F8</Color>
    <Color x:Key="PinkHotColor">#FF3690F7</Color>
    <Color x:Key="PinkPastelColor">#FFABCDF4</Color>
    <Color x:Key="TextColor">#FFF2F5F7</Color>
    <Color x:Key="TextDimColor">#FFA7B4C3</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="PinkNeonBrush" Color="{StaticResource PinkNeonColor}" />
    <SolidColorBrush x:Key="PinkPastelBrush" Color="{StaticResource PinkPastelColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="BorderBrushPink" Color="#6656A2F8" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#3382BAFA" />
    <SolidColorBrush x:Key="TrackBrush" Color="#33FFFFFF" />

    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F215171B" Offset="0" />
        <GradientStop Color="#F2121418" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NeonGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF65AAF9" Offset="0" />
        <GradientStop Color="#FF2F7ED9" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CC1C1E23" Offset="0" />
        <GradientStop Color="#B316181C" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ShortcutBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E61D2027" Offset="0" />
        <GradientStop Color="#E617191E" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ShortcutHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2232730" Offset="0" />
        <GradientStop Color="#F2191C23" Offset="1" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="PinkGlow" Color="#FF56A2F8" BlurRadius="22" ShadowDepth="0" Opacity="0.35" />
    <DropShadowEffect x:Key="PinkGlowStrong" Color="#FF56A2F8" BlurRadius="26" ShadowDepth="0" Opacity="0.6" />
    <DropShadowEffect x:Key="TextGlow" Color="#FF56A2F8" BlurRadius="14" ShadowDepth="0" Opacity="0.7" />

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Flor de sakura (decoração discreta) -->
    <DrawingImage x:Key="SakuraFlower">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.Children>
                    <GeometryDrawing Brush="#FF6FA9EB" Geometry="M0,0 C-7,-8 -7,-19 0,-24 C7,-19 7,-8 0,0Z" />
                    <GeometryDrawing Brush="#FF6FA9EB">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M0,0 C-7,-8 -7,-19 0,-24 C7,-19 7,-8 0,0Z">
                                <PathGeometry.Transform><RotateTransform Angle="72" /></PathGeometry.Transform>
                            </PathGeometry>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF6FA9EB">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M0,0 C-7,-8 -7,-19 0,-24 C7,-19 7,-8 0,0Z">
                                <PathGeometry.Transform><RotateTransform Angle="144" /></PathGeometry.Transform>
                            </PathGeometry>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF6FA9EB">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M0,0 C-7,-8 -7,-19 0,-24 C7,-19 7,-8 0,0Z">
                                <PathGeometry.Transform><RotateTransform Angle="216" /></PathGeometry.Transform>
                            </PathGeometry>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF6FA9EB">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M0,0 C-7,-8 -7,-19 0,-24 C7,-19 7,-8 0,0Z">
                                <PathGeometry.Transform><RotateTransform Angle="288" /></PathGeometry.Transform>
                            </PathGeometry>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFE2E7EE">
                        <GeometryDrawing.Geometry><EllipseGeometry Center="0,0" RadiusX="4" RadiusY="4" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup.Children>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>


