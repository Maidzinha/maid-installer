<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ MAID INSTALLER — TEMA CLARO ============ -->

    <!-- Paleta -->
    <Color x:Key="BgColor">#FFE9EAED</Color>
    <Color x:Key="Bg2Color">#FFE3E5EA</Color>
    <Color x:Key="CardColor">#C2E0E1E5</Color>
    <Color x:Key="PinkNeonColor">#FF1B82F6</Color>
    <Color x:Key="PinkHotColor">#FF0970E7</Color>
    <Color x:Key="PinkPastelColor">#FF0B2D54</Color>
    <Color x:Key="TextColor">#FF080B0D</Color>
    <Color x:Key="TextDimColor">#FF3C4958</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="PinkNeonBrush" Color="{StaticResource PinkNeonColor}" />
    <SolidColorBrush x:Key="PinkPastelBrush" Color="{StaticResource PinkPastelColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="BorderBrushPink" Color="#661B82F6" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#33053D7D" />
    <SolidColorBrush x:Key="TrackBrush" Color="#33000000" />

    <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2E4E6EA" Offset="0" />
        <GradientStop Color="#F2E7E9ED" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NeonGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF2A89F7" Offset="0" />
        <GradientStop Color="#FF1F60AB" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CCDCDEE3" Offset="0" />
        <GradientStop Color="#B3E3E5E9" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ShortcutBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E6D8DBE2" Offset="0" />
        <GradientStop Color="#E6E1E3E8" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ShortcutHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2CFD3DC" Offset="0" />
        <GradientStop Color="#F2DCDFE6" Offset="1" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="PinkGlow" Color="#FF1B82F6" BlurRadius="22" ShadowDepth="0" Opacity="0.35" />
    <DropShadowEffect x:Key="PinkGlowStrong" Color="#FF1B82F6" BlurRadius="26" ShadowDepth="0" Opacity="0.6" />
    <DropShadowEffect x:Key="TextGlow" Color="#FF1B82F6" BlurRadius="14" ShadowDepth="0" Opacity="0.7" />

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Flor de sakura (decoração discreta) -->
    <DrawingImage x:Key="SakuraFlower">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.Children>
                    <GeometryDrawing Brush="#FF3989E4" Geometry="M0,0 C-7,-8 -7,-19 0,-24 C7,-19 7,-8 0,0Z" />
                    <GeometryDrawing Brush="#FF3989E4">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M0,0 C-7,-8 -7,-19 0,-24 C7,-19 7,-8 0,0Z">
                                <PathGeometry.Transform><RotateTransform Angle="72" /></PathGeometry.Transform>
                            </PathGeometry>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF3989E4">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M0,0 C-7,-8 -7,-19 0,-24 C7,-19 7,-8 0,0Z">
                                <PathGeometry.Transform><RotateTransform Angle="144" /></PathGeometry.Transform>
                            </PathGeometry>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF3989E4">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M0,0 C-7,-8 -7,-19 0,-24 C7,-19 7,-8 0,0Z">
                                <PathGeometry.Transform><RotateTransform Angle="216" /></PathGeometry.Transform>
                            </PathGeometry>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF3989E4">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M0,0 C-7,-8 -7,-19 0,-24 C7,-19 7,-8 0,0Z">
                                <PathGeometry.Transform><RotateTransform Angle="288" /></PathGeometry.Transform>
                            </PathGeometry>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF11161D">
                        <GeometryDrawing.Geometry><EllipseGeometry Center="0,0" RadiusX="4" RadiusY="4" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup.Children>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>


