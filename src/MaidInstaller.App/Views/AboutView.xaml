<UserControl x:Class="MaidInstaller.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MaidInstaller.App.Localization">
    <Grid Style="{StaticResource PageRoot}" Margin="40,40,40,30">
        <Border Style="{StaticResource GlassPanel}" Padding="34,30" MaxWidth="760" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/logo.png" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Maid Installer ♡" FontSize="28" FontWeight="Bold" />
                        <TextBlock Text="{loc:T 'Personal Edition — Prepare seu PC com carinho.'}" Foreground="{StaticResource TextDimBrush}" FontSize="14" />
                    </StackPanel>
                </StackPanel>

                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </Grid.Resources>
                    <TextBlock Text="{loc:T 'Versão'}" Foreground="{StaticResource TextDimBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Version}" />
                    <TextBlock Grid.Row="1" Text="{loc:T 'Modo'}" Foreground="{StaticResource TextDimBrush}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Mode}" />
                    <TextBlock Grid.Row="2" Text="{loc:T 'Sistema'}" Foreground="{StaticResource TextDimBrush}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Windows}" />
                    <TextBlock Grid.Row="3" Text="{loc:T 'Runtime'}" Foreground="{StaticResource TextDimBrush}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Runtime}" />
                    <TextBlock Grid.Row="4" Text="{loc:T 'Pasta de dados'}" Foreground="{StaticResource TextDimBrush}" Margin="0,6" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DataRoot}" Margin="0,6" />
                    <TextBlock Grid.Row="5" Text="{loc:T 'Pasta do app'}" Foreground="{StaticResource TextDimBrush}" Margin="0,6" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AppDirectory}" Margin="0,6" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button Style="{StaticResource AccentButton}" Command="{Binding OpenDataFolderCommand}" Content="{loc:T 'Abrir pasta de dados'}" />
                    <Button Style="{StaticResource AccentButton}" Command="{Binding OpenLogsFolderCommand}" Content="{loc:T 'Abrir logs'}" Margin="10,0,0,0" />
                </StackPanel>

                <TextBlock Margin="0,22,0,0" FontSize="12.5" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"
                           Text="{loc:T 'Feito por Maidzinha. O Maid Installer não reinicia o PC sozinho, não desativa proteções do Windows e pede autorização antes de qualquer ação administrativa.'}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
