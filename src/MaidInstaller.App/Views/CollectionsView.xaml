<UserControl x:Class="MaidInstaller.App.Views.CollectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MaidInstaller.App.Localization">
    <UserControl.Resources>
        <!-- Ícone real do app ou a inicial -->
        <DataTemplate x:Key="AppIcon">
            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource B_33FF4FA3}">
                <Grid>
                    <Image Source="{Binding Icon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding Icon, Converter={StaticResource NullToVis}}" />
                    <TextBlock Text="{Binding Monogram}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PinkPastelBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Icon, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="StatusChip" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                    <Setter Property="Background" Value="{StaticResource B_55FF4FA3}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRoot}" Margin="22,14,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Margin="0,6,150,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PageGlyph}" Style="{StaticResource IconText}" FontSize="24" />
                    <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Bold" Margin="12,0,0,0" />
                    <TextBlock Text=" ♡" FontSize="28" Foreground="{StaticResource PinkNeonBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="2,2,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Coleções ===== -->
            <Border Style="{StaticResource GlassPanel}" Padding="10,12" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="2" Margin="2,0,2,10">
                        <Button Style="{StaticResource AccentButton}" Margin="0,0,4,0" Command="{Binding NewCommand}" AutomationProperties.Name="{Binding NewText}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding NewText}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Margin="4,0,0,0" Command="{Binding ImportCommand}" AutomationProperties.Name="{loc:T 'Importar'}"
                                ToolTip="{loc:T 'Abrir um arquivo .maidlist.json exportado (de outro PC, por exemplo)'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B5;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{loc:T 'Importar'}" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource CategoryItem}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="17" HorizontalAlignment="Left" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CountText}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource Chip}" Background="{StaticResource B_44FF4FA3}" VerticalAlignment="Center"
                                            Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVis}}" ToolTip="{loc:T 'Perfil pronto (editável)'}">
                                        <TextBlock Text="{loc:T 'Pronto'}" FontSize="10.5" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" Text="{Binding EmptyText}" TextWrapping="Wrap" FontSize="13" Margin="8,10" Foreground="{StaticResource TextDimBrush}"
                               Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />

                    <StackPanel Grid.Row="2" Margin="2,10,2,0">
                        <Button Style="{StaticResource GhostButton}" Content="{loc:T 'Restaurar perfis prontos'}" Command="{Binding RestoreDefaultsCommand}"
                                Visibility="{Binding IsProfiles, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8"
                                ToolTip="{loc:T 'Recria PC Gamer, PC Trabalho e PC Completo se tiverem sido excluídos'}" />
                        <TextBlock Text="{Binding FolderText}" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Editor ===== -->
            <Border Grid.Column="1" Style="{StaticResource GlassPanel}" Padding="22,18"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Nome e descrição (salvos ao sair do campo ou com Enter) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource B_33FF4FA3}" BorderThickness="1" BorderBrush="{StaticResource BorderBrushPink}">
                            <TextBlock Text="{Binding Selected.Glyph}" Style="{StaticResource IconText}" FontSize="24" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBox Style="{StaticResource ChatTextBox}" Height="40" FontSize="18" FontWeight="SemiBold" Tag="{loc:T 'Nome'}"
                                     MaxLength="60" Text="{Binding EditName, UpdateSourceTrigger=LostFocus}" KeyDown="CommitOnEnter"
                                     ToolTip="{loc:T 'Clique para renomear'}" />
                            <TextBox Style="{StaticResource ChatTextBox}" Height="34" Margin="0,8,0,0" FontSize="13" Tag="{loc:T 'Descrição (opcional)'}"
                                     MaxLength="300" Text="{Binding EditDescription, UpdateSourceTrigger=LostFocus}" KeyDown="CommitOnEnter" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding SavedText}" FontSize="12" Foreground="{StaticResource PinkPastelBrush}" Margin="66,8,0,0" />

                    <!-- Ações -->
                    <WrapPanel Grid.Row="2" Margin="0,14,0,12">
                        <Button Style="{StaticResource AccentButton}" Command="{Binding InstallAllCommand}" Margin="0,0,8,8" AutomationProperties.Name="{loc:T 'Instalar todos'}"
                                ToolTip="{loc:T 'Mostra a confirmação com tudo o que será instalado'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:T 'Instalar todos'}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Content="{loc:T 'Adicionar apps'}" Command="{Binding OpenPickerCommand}" Margin="0,0,8,8" />
                        <Button Style="{StaticResource GhostButton}" Content="{loc:T 'Duplicar'}" Command="{Binding DuplicateCommand}" Margin="0,0,8,8" />
                        <Button Style="{StaticResource GhostButton}" Content="{loc:T 'Exportar'}" Command="{Binding ExportCommand}" Margin="0,0,8,8"
                                ToolTip="{loc:T 'Salvar um arquivo .maidlist.json para levar a outro PC'}" />
                        <Button Style="{StaticResource GhostButton}" Content="{loc:T 'Excluir'}" Command="{Binding DeleteCommand}" Margin="0,0,8,8" />
                    </WrapPanel>

                    <!-- Apps da coleção -->
                    <Grid Grid.Row="3" Visibility="{Binding IsPicking, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Apps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="240" Height="64" CornerRadius="14" Padding="10,8" Margin="0,0,10,10"
                                                Background="{StaticResource CardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderBrushSoft}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AppIcon}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding App.Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <Border Style="{StaticResource StatusChip}">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource ChromeButton}" Width="30" Height="30" Content="&#xE711;" FontSize="11"
                                                        ToolTip="{loc:T 'Remover desta lista (não desinstala)'}" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasApps, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <TextBlock Text="{loc:T 'Ainda não há apps aqui ♡'}" FontSize="15" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" />
                            <Button Style="{StaticResource AccentButton}" Content="{loc:T 'Adicionar apps'}" Command="{Binding OpenPickerCommand}"
                                    HorizontalAlignment="Center" Margin="0,12,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Escolher apps do catálogo -->
                    <Grid Grid.Row="3" Visibility="{Binding IsPicking, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Style="{StaticResource ChatTextBox}" Height="36" Tag="{loc:T 'Pesquisar no catálogo…'}"
                                 Text="{Binding PickerSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PickerView}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Card" Width="240" Height="60" CornerRadius="14" Padding="10,8" Margin="0,0,10,10"
                                                Background="{StaticResource CardBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderBrushSoft}">
                                            <CheckBox Style="{StaticResource PinkCheck}" IsChecked="{Binding IsChecked}" VerticalAlignment="Center"
                                                      AutomationProperties.Name="{Binding Item.App.Name}">
                                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                                    <ContentPresenter Content="{Binding Item}" ContentTemplate="{StaticResource AppIcon}" />
                                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" Width="140">
                                                        <TextBlock Text="{Binding Item.App.Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Item.CategoryName}" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </CheckBox>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PinkNeonBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="{loc:T 'Cancelar'}" Command="{Binding CancelPickerCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource AccentButton}" Content="{loc:T 'Adicionar selecionados'}" Command="{Binding ConfirmPickerCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
