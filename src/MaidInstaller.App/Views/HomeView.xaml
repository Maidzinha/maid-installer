<UserControl x:Class="MaidInstaller.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MaidInstaller.App.Localization">
    <Grid Style="{StaticResource PageRoot}" Margin="20,10,18,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="370" />
        </Grid.ColumnDefinitions>

        <!-- ================= Área central ================= -->
        <Grid Margin="0,0,18,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Saudação -->
            <StackPanel HorizontalAlignment="Center" Margin="0,22,0,0">
                <TextBlock HorizontalAlignment="Center" FontSize="40" FontWeight="Bold">
                    <Run Text="{Binding WelcomePrefix, Mode=OneWay}" /><Run Text="{Binding UserName, Mode=OneWay}" FontStyle="Italic"
                         Foreground="{StaticResource PinkNeonBrush}" /><Run Text="! " /><Run Text="♡" Foreground="{StaticResource PinkNeonBrush}" />
                </TextBlock>
                <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="15" Foreground="{StaticResource TextDimBrush}"
                           Text="{loc:T 'Maid Installer — Prepare seu PC de forma rápida, completa e personalizada.'}" />
            </StackPanel>

            <!-- Mascote + atalhos -->
            <Grid Grid.Row="1" Grid.RowSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.ColumnSpan="2" Source="{Binding MascotImage}" Stretch="Uniform" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                       Margin="-14,6,0,0" MaxWidth="470" RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding MascotImage, Converter={StaticResource NullToVis}}" />

                <ItemsControl Grid.Column="1" ItemsSource="{Binding Shortcuts}" VerticalAlignment="Center" Margin="0,0,0,90">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2" Rows="3" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ShortcutButton}" Command="{Binding Command}" Width="192" Height="94" Margin="6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="24" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"
                                               HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Acesso rápido -->
            <Border Grid.Row="2" Style="{StaticResource GlassPanel}" Padding="18,12,8,14" Margin="110,0,0,0" HorizontalAlignment="Stretch"
                    DataContext="{Binding QuickAccess}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="&#xE945;" Style="{StaticResource IconText}" FontSize="16" />
                        <TextBlock Text="{loc:T 'Acesso Rápido'}" Style="{StaticResource PanelTitle}" Margin="10,0,0,0" />
                        <TextBlock Text="{loc:T '  carregando…'}" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding LaunchCommand}" ToolTip="{Binding Tooltip}">
                                    <Grid>
                                        <Image Source="{Binding Icon}" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding Icon, Converter={StaticResource NullToVis}}" />
                                        <TextBlock Text="{Binding Monogram}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PinkPastelBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding Icon, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                                    </Grid>
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource QuickAppButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Button Grid.Row="2" Style="{StaticResource IconButton}" DataContext="{Binding QuickAccess}" Command="{Binding AddCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0" Content="&#xE710;"
                    ToolTip="{loc:T 'Adicionar favoritos pela Biblioteca de Apps'}" />
        </Grid>

        <!-- ================= Painel direito ================= -->
        <Grid Grid.Column="1" Margin="0,34,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Status do Sistema -->
            <Border Style="{StaticResource GlassPanel}" DataContext="{Binding SystemStatus}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" Style="{StaticResource IconText}" FontSize="18" />
                            <TextBlock Text="{loc:T 'Status do Sistema'}" Style="{StaticResource PanelTitle}" Margin="10,0,0,0" />
                        </StackPanel>
                        <Path HorizontalAlignment="Right" Stroke="{StaticResource PinkNeonBrush}" StrokeThickness="1.6" Opacity="0.9"
                              Data="M0,10 L22,10 L27,2 L32,18 L37,6 L41,10 L56,10" Effect="{StaticResource TextGlow}" />
                    </Grid>

                    <!-- Windows -->
                    <Grid Margin="0,0,0,12" ToolTip="{Binding WindowsBuild}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE770;" Style="{StaticResource IconText}" FontSize="15" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="1" Text="{Binding WindowsVersion}" FontSize="14" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!-- CPU -->
                    <Grid Margin="0,0,0,12" ToolTip="{Binding CpuName}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource IconText}" FontSize="15" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="1" Text="{Binding CpuName}" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                        <ProgressBar Grid.Column="2" Style="{StaticResource PinkMeter}" Value="{Binding CpuValue, Mode=OneWay}" />
                        <TextBlock Grid.Column="3" Text="{Binding CpuText}" FontSize="13" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- GPU -->
                    <Grid Margin="0,0,0,12" ToolTip="{Binding GpuName}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7F4;" Style="{StaticResource IconText}" FontSize="15" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="1" Text="{Binding GpuName}" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                        <ProgressBar Grid.Column="2" Style="{StaticResource PinkMeter}" Value="{Binding GpuValue, Mode=OneWay}"
                                     Visibility="{Binding GpuAvailable, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="3" Text="{Binding GpuText}" FontSize="13" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- RAM -->
                    <Grid Margin="0,0,0,12" ToolTip="{Binding RamTooltip}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE964;" Style="{StaticResource IconText}" FontSize="15" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="1" Text="{Binding RamName}" FontSize="14" Margin="0,0,8,0" />
                        <ProgressBar Grid.Column="2" Style="{StaticResource PinkMeter}" Value="{Binding RamValue, Mode=OneWay}" />
                        <TextBlock Grid.Column="3" Text="{Binding RamText}" FontSize="13" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- Temperatura -->
                    <Grid ToolTip="{loc:T 'Temperaturas aparecem quando o hardware/driver permite (NVIDIA via nvidia-smi; zona térmica ACPI normalmente só como administrador).'}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE9CA;" Style="{StaticResource IconText}" FontSize="15" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="1" FontSize="13" Foreground="{StaticResource TextDimBrush}">
                            <Run Text="{loc:T 'Temperatura: '}" /><Run Text="{Binding TemperatureText, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Maid Assistant -->
            <Border Grid.Row="1" Margin="0,18,0,0" Padding="16" DataContext="{Binding Assistant}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="54" Height="54" CornerRadius="27" BorderThickness="2" BorderBrush="{StaticResource PinkNeonBrush}"
                                Effect="{StaticResource PinkGlow}">
                            <Border.Background>
                                <ImageBrush ImageSource="/Assets/avatar.png" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Maid Assistant" Style="{StaticResource PanelTitle}" />
                                <TextBlock Text=" ♡" FontSize="17" Foreground="{StaticResource PinkNeonBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource PinkNeonBrush}" Effect="{StaticResource TextGlow}" />
                                <TextBlock Text="{Binding StatusText}" FontSize="13" Margin="6,0,0,0" Foreground="{StaticResource TextDimBrush}"
                                           ToolTip="{Binding StatusTooltip}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Command="{Binding ToggleMinimizedCommand}" VerticalAlignment="Top">
                            <Button.Content>
                                <TextBlock FontFamily="{StaticResource IconFont}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE921;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                                                    <Setter Property="Text" Value="&#xE710;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                            <Button.ToolTip>
                                <ToolTip Content="{loc:T 'Minimizar / expandir a assistente'}" />
                            </Button.ToolTip>
                        </Button>
                    </Grid>

                    <!-- Conversa -->
                    <ScrollViewer x:Name="ChatScroll" Grid.Row="1" Margin="0,14,0,10" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsMinimized, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Bubble" CornerRadius="14" Padding="12,9" Margin="0,0,0,8" MaxWidth="290" ToolTip="{Binding SourceNote}"
                                            HorizontalAlignment="Left" Background="{StaticResource B_B33A1427}" BorderThickness="1" BorderBrush="{StaticResource BorderBrushPink}">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13.5" LineHeight="19" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding FromUser}" Value="True">
                                            <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                            <Setter TargetName="Bubble" Property="Background" Value="{StaticResource B_CC24161D}" />
                                            <Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Sugestões -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Suggestions}"
                                  Visibility="{Binding IsMinimized, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SuggestionButton}" Command="{Binding DataContext.AskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE735;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Campo de pergunta -->
                    <Grid Grid.Row="3" Margin="0,6,0,0" Height="44"
                          Visibility="{Binding IsMinimized, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource ChatTextBox}" Tag="{loc:T 'Pergunte sobre os aplicativos…'}" MaxLength="300"
                                 Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SendCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Style="{StaticResource AccentButton}" Width="48" Margin="8,0,0,0" Padding="0"
                                Command="{Binding SendCommand}" ToolTip="{loc:T 'Enviar'}" AutomationProperties.Name="{loc:T 'Enviar'}">
                            <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}" FontSize="16" />
                        </Button>
                    </Grid>
                </Grid>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                                <Setter Property="VerticalAlignment" Value="Top" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </Grid>
    </Grid>
</UserControl>
