<UserControl x:Class="MaidInstaller.App.Views.InstallsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:MaidInstaller.Core.Installation;assembly=MaidInstaller.Core">
    <Grid Style="{StaticResource PageRoot}" Margin="32,26,32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Margin="0,0,150,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" Style="{StaticResource IconText}" FontSize="26" />
                    <TextBlock Text="Instalações" FontSize="28" FontWeight="Bold" Margin="12,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding Summary}" Margin="0,6,0,0" FontSize="14" Foreground="{StaticResource TextDimBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{StaticResource GhostButton}" Content="Limpar concluídos" Command="{Binding ClearFinishedCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource GhostButton}" Content="Cancelar tudo" Command="{Binding CancelAllCommand}" />
            </StackPanel>
        </Grid>

        <!-- Aviso de reinício (o app nunca reinicia sozinho) -->
        <Border Grid.Row="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,14" Background="#33FF4FA3"
                BorderThickness="1" BorderBrush="{StaticResource BorderBrushPink}"
                Visibility="{Binding RebootRequired, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE777;" Style="{StaticResource IconText}" FontSize="16" />
                <TextBlock Margin="10,0,0,0" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="Uma instalação pediu para reiniciar o PC. Salve o que estiver fazendo e reinicie quando quiser — o Maid Installer não reinicia sozinho." />
            </StackPanel>
        </Border>

        <!-- Vazio -->
        <Border Grid.Row="2" Style="{StaticResource GlassPanel}" Padding="34,30" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding HasJobs, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
            <StackPanel>
                <TextBlock Text="Nada na fila por enquanto ♡" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Margin="0,10,0,0" FontSize="14" Foreground="{StaticResource TextDimBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                           Text="Escolha aplicativos na Biblioteca de Apps e clique em Instalar. Eles aparecem aqui, um de cada vez, com o andamento real." />
            </StackPanel>
        </Border>

        <!-- Lista de instalações -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Jobs}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                 Visibility="{Binding HasJobs, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="16" Padding="16,14" Background="{StaticResource GlassBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderBrushSoft}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Ícone real ou monograma -->
                            <Grid Width="44" Height="44" VerticalAlignment="Top">
                                <Border CornerRadius="12" Background="#33FF4FA3" Visibility="{Binding Icon, Converter={StaticResource NullToVis}, ConverterParameter=Invert}">
                                    <TextBlock Text="{Binding Monogram}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Image Source="{Binding Icon}" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="14,0,14,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                    <Border x:Name="StatusChip" Style="{StaticResource Chip}" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding SourceText}" FontSize="12" Margin="0,3,0,8" Foreground="{StaticResource TextDimBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Barra: porcentagem só quando o WinGet informa; senão, indicador de atividade -->
                                    <ProgressBar Style="{StaticResource ActivityBar}" Height="8" Minimum="0" Maximum="100"
                                                 Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding Job.ShowActivity, Mode=OneWay}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="12" Margin="10,0,0,0" MinWidth="80"
                                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding Job.Message}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource GhostButton}" Content="Cancelar" Margin="0,0,8,0" CommandParameter="{Binding}"
                                        Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Visibility="{Binding Job.CanCancel, Converter={StaticResource BoolToVis}}" />
                                <Button Style="{StaticResource AccentButton}" Content="Tentar novamente" Margin="0,0,8,0" CommandParameter="{Binding}"
                                        Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Visibility="{Binding Job.CanRetry, Converter={StaticResource BoolToVis}}" />
                                <Button Style="{StaticResource GhostButton}" Content="Ver log" CommandParameter="{Binding}"
                                        Command="{Binding DataContext.OpenLogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Visibility="{Binding Job.LogFile, Converter={StaticResource NullToVis}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Job.State}" Value="{x:Static core:InstallJobState.Completed}">
                            <Setter TargetName="StatusChip" Property="Background" Value="#5532C878" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Job.State}" Value="{x:Static core:InstallJobState.AlreadyInstalled}">
                            <Setter TargetName="StatusChip" Property="Background" Value="#4432C878" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Job.State}" Value="{x:Static core:InstallJobState.Failed}">
                            <Setter TargetName="StatusChip" Property="Background" Value="#77E0344A" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Job.State}" Value="{x:Static core:InstallJobState.Downloading}">
                            <Setter TargetName="StatusChip" Property="Background" Value="#66FF4FA3" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Job.State}" Value="{x:Static core:InstallJobState.Installing}">
                            <Setter TargetName="StatusChip" Property="Background" Value="#66FF4FA3" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
