<UserControl x:Class="MaidInstaller.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MaidInstaller.App.Localization">
    <Grid Style="{StaticResource PageRoot}" Margin="22,14,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Margin="0,6,150,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE71D;" Style="{StaticResource IconText}" FontSize="24" />
                    <TextBlock Text="{loc:T 'Biblioteca de Apps'}" FontSize="28" FontWeight="Bold" Margin="12,0,0,0" />
                    <TextBlock Text=" ♡" FontSize="28" Foreground="{StaticResource PinkNeonBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="2,2,0,0" />
            </StackPanel>
        </Grid>

        <!-- Pesquisa e filtros -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource ChatTextBox}" Height="38" Tag="{loc:T 'Pesquisar por nome, função ou desenvolvedor…'}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
            <WrapPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource PillRadio}" GroupName="status" Content="{loc:T 'Todos'}"
                             IsChecked="{Binding StatusFilter, Converter={StaticResource EnumEquals}, ConverterParameter=All}" />
                <RadioButton Style="{StaticResource PillRadio}" GroupName="status" Content="{loc:T 'Instalados'}"
                             IsChecked="{Binding StatusFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Installed}" />
                <RadioButton Style="{StaticResource PillRadio}" GroupName="status" Content="{loc:T 'Não instalados'}"
                             IsChecked="{Binding StatusFilter, Converter={StaticResource EnumEquals}, ConverterParameter=NotInstalled}" />
                <Rectangle Width="1" Height="22" Fill="{StaticResource BorderBrushSoft}" Margin="4,0,12,0" />
                <ToggleButton Style="{StaticResource PillToggle}" Content="{loc:T 'Só gratuitos'}" IsChecked="{Binding OnlyFree}" />
                <ToggleButton Style="{StaticResource PillToggle}" Content="{loc:T 'Só com WinGet'}" IsChecked="{Binding OnlyWinGet}" />
            </WrapPanel>
            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}"
                    ToolTip="{loc:T 'Consultar de novo o WinGet para saber o que está instalado'}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{loc:T 'Verificar instalados'}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Conteúdo -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Categorias -->
            <Border Style="{StaticResource GlassPanel}" Padding="8,10" Margin="0,0,12,0">
                <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" ItemContainerStyle="{StaticResource CategoryItem}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="15" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Apps -->
            <Grid Grid.Column="1">
                <ListBox ItemsSource="{Binding AppsView}" SelectedItem="{Binding Current}" ItemContainerStyle="{StaticResource AppCard}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="False">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource PinkCheck}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                          ToolTip="{loc:T 'Selecionar para instalar em lote'}" />
                                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="11" Margin="8,0,8,0" Background="{StaticResource B_33FF4FA3}">
                                    <Grid>
                                        <Image Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding Icon, Converter={StaticResource NullToVis}}" />
                                        <TextBlock Text="{Binding Monogram}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PinkPastelBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding Icon, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding App.Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding App.Developer}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
                                    <Border Margin="0,4,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource B_55FF4FA3}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VisibleCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{loc:T 'Nenhum aplicativo encontrado com esses filtros ♡'}" FontSize="15" Foreground="{StaticResource TextDimBrush}" />
                    <Button Style="{StaticResource GhostButton}" Content="{loc:T 'Limpar filtros'}" Command="{Binding ClearFiltersCommand}"
                            HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>

            <!-- Detalhes -->
            <Border Grid.Column="2" Style="{StaticResource GlassPanel}" Margin="4,0,0,0" Padding="20"
                    DataContext="{Binding Current}" Visibility="{Binding Converter={StaticResource NullToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="58" Height="58" CornerRadius="15" Background="{StaticResource B_33FF4FA3}" BorderThickness="1" BorderBrush="{StaticResource BorderBrushPink}">
                                <Grid>
                                    <Image Source="{Binding Icon}" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding Icon, Converter={StaticResource NullToVis}}" />
                                    <TextBlock Text="{Binding Monogram}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PinkPastelBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding Icon, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                                </Grid>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" MaxWidth="220">
                                <TextBlock Text="{Binding App.Name}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CategoryName}" FontSize="12.5" Foreground="{StaticResource PinkPastelBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding App.Description}" TextWrapping="Wrap" FontSize="13.5" LineHeight="20" Margin="0,16,0,0" />
                        <TextBlock Text="{Binding App.Notes}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource PinkPastelBrush}" Margin="0,8,0,0"
                                   Visibility="{Binding App.Notes, Converter={StaticResource NullToVis}}" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12.5" />
                                    <Setter Property="Margin" Value="0,0,0,7" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </Grid.Resources>
                            <TextBlock Text="{loc:T 'Status'}" Foreground="{StaticResource TextDimBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Text="{loc:T 'Desenvolvedor'}" Foreground="{StaticResource TextDimBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding App.Developer}" />
                            <TextBlock Grid.Row="2" Text="{loc:T 'Preço'}" Foreground="{StaticResource TextDimBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding App.Price}" />
                            <TextBlock Grid.Row="3" Text="{loc:T 'Licença'}" Foreground="{StaticResource TextDimBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding App.License}" />
                            <TextBlock Grid.Row="4" Text="{loc:T 'Tamanho'}" Foreground="{StaticResource TextDimBrush}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SizeText}" />
                            <TextBlock Grid.Row="5" Text="{loc:T 'Fonte'}" Foreground="{StaticResource TextDimBrush}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SourceText}" />
                            <TextBlock Grid.Row="6" Text="{loc:T 'Versão'}" Foreground="{StaticResource TextDimBrush}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding VerifiedVersionText}" />
                            <TextBlock Grid.Row="7" Text="{loc:T 'Versão atual'}" Foreground="{StaticResource TextDimBrush}"
                                       Visibility="{Binding LiveVersion, Converter={StaticResource NullToVis}}" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding LiveVersion}" Foreground="{StaticResource PinkPastelBrush}"
                                       Visibility="{Binding LiveVersion, Converter={StaticResource NullToVis}}" />
                        </Grid>

                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                                    Command="{Binding DataContext.CheckVersionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                    ToolTip="{loc:T 'Consulta o WinGet agora para ver a versão mais recente'}">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{loc:T 'Consultar versão atual'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCheckingVersion}" Value="True">
                                                    <Setter Property="Text" Value="{loc:T 'Consultando…'}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,8,8" Content="{loc:T 'Site oficial'}"
                                    Command="{Binding DataContext.OpenSiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                    ToolTip="{Binding App.OfficialUrl}" />
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,8,8" Content="{Binding FavoriteText}"
                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                        </WrapPanel>

                        <Button Style="{StaticResource AccentButton}" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                                Content="{Binding InstallButtonText}"
                                Command="{Binding DataContext.InstallCurrentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Barra de seleção -->
        <Border Grid.Row="3" Style="{StaticResource GlassPanel}" Padding="18,10" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE73A;" Style="{StaticResource IconText}" FontSize="16" />
                    <TextBlock Text="{Binding SelectionText}" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding StatusLine}" FontSize="12.5" Foreground="{StaticResource TextDimBrush}"
                           VerticalAlignment="Center" Margin="20,0" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Content="{loc:T 'Selecionar visíveis'}" Command="{Binding SelectVisibleCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource GhostButton}" Content="{loc:T 'Limpar seleção'}" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource GhostButton}" Content="{loc:T 'Salvar como lista'}" Command="{Binding SaveAsListCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource AccentButton}" Content="{loc:T 'Instalar selecionados'}" Command="{Binding InstallSelectedCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
