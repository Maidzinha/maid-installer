<UserControl x:Class="MaidInstaller.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource PageRoot}" Margin="40,40,40,30">
        <Border Style="{StaticResource GlassPanel}" Padding="34,30" MaxWidth="720" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="30" />
                    <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Bold" Margin="14,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Border CornerRadius="10" Padding="10,4" Margin="0,16,0,0" HorizontalAlignment="Left" Background="#33FF4FA3"
                        BorderThickness="1" BorderBrush="{StaticResource BorderBrushPink}">
                    <TextBlock FontSize="13">
                        <Run Text="Em desenvolvimento · " /><Run Text="{Binding Stage, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </Border>
                <TextBlock Margin="0,18,0,10" FontSize="14" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"
                           Text="Esta área ainda não está funcionando. Nada aqui instala ou altera o seu PC por enquanto. O que vai chegar:" />
                <ItemsControl ItemsSource="{Binding Planned}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="♡" Foreground="{StaticResource PinkNeonBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding}" FontSize="14" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
