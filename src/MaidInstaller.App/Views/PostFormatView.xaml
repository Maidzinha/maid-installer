<UserControl x:Class="MaidInstaller.App.Views.PostFormatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MaidInstaller.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="KitCard" DataType="{x:Type vm:KitCardViewModel}">
            <Border CornerRadius="18" Padding="18,16" Margin="0,0,0,14" Background="{StaticResource GlassBrush}"
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrushSoft}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="12" Background="#33FF4FA3" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="19" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                            <Border x:Name="Chip" Style="{StaticResource Chip}" Margin="0,4,0,0">
                                <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,10,0,0" />

                    <!-- Sem progresso real: indicador de atividade -->
                    <ProgressBar Style="{StaticResource ActivityBar}" Height="6" Margin="0,10,0,0" IsIndeterminate="{Binding IsBusy}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                    <ItemsControl ItemsSource="{Binding Details}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,2" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Planos de energia existentes -->
                    <ListBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" DisplayMemberPath="Name"
                             ItemContainerStyle="{StaticResource CategoryItem}" Background="Transparent" BorderThickness="0" Margin="0,6,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding HasOptions, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <ItemsControl ItemsSource="{Binding Actions}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,8,8">
                                    <Button Style="{StaticResource AccentButton}" Content="{Binding Label}" Command="{Binding Command}" ToolTip="{Binding Tooltip}"
                                            Visibility="{Binding Primary, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource GhostButton}" Content="{Binding Label}" Command="{Binding Command}" ToolTip="{Binding Tooltip}"
                                            Visibility="{Binding Primary, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Ok">
                    <Setter TargetName="Chip" Property="Background" Value="#5532C878" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter TargetName="Chip" Property="Background" Value="#77E0A034" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Info">
                    <Setter TargetName="Chip" Property="Background" Value="#44FF4FA3" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Busy">
                    <Setter TargetName="Chip" Property="Background" Value="#66FF4FA3" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRoot}" Margin="22,14,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,6,150,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE90F;" Style="{StaticResource IconText}" FontSize="24" />
                    <TextBlock Text="Kit Pós-Formatação" FontSize="28" FontWeight="Bold" Margin="12,0,0,0" />
                    <TextBlock Text=" ♡" FontSize="28" Foreground="{StaticResource PinkNeonBrush}" />
                </StackPanel>
                <TextBlock FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="2,2,0,0" TextWrapping="Wrap"
                           Text="Verificações e ajustes para deixar o Windows pronto. As verificações só leem; qualquer mudança pede sua confirmação antes." />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding CheckAllCommand}" VerticalAlignment="Bottom"
                    AutomationProperties.Name="Verificar tudo">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Verificar tudo" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{Binding LeftCards}" ItemTemplate="{StaticResource KitCard}" />
                <ItemsControl Grid.Column="2" ItemsSource="{Binding RightCards}" ItemTemplate="{StaticResource KitCard}" />
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
