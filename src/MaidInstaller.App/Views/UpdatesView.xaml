<UserControl x:Class="MaidInstaller.App.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MaidInstaller.App.Localization">
    <Grid Style="{StaticResource PageRoot}" Margin="22,14,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Margin="0,6,150,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE895;" Style="{StaticResource IconText}" FontSize="24" />
                    <TextBlock Text="{loc:T 'Atualizações'}" FontSize="28" FontWeight="Bold" Margin="12,0,0,0" />
                    <TextBlock Text=" ♡" FontSize="28" Foreground="{StaticResource PinkNeonBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusLine}" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="2,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding CheckCommand}" VerticalAlignment="Bottom"
                    AutomationProperties.Name="{loc:T 'Verificar atualizações'}" ToolTip="{loc:T 'Só consulta; não atualiza nada'}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{loc:T 'Verificar atualizações'}" />
                </StackPanel>
            </Button>
        </Grid>

        <ProgressBar Grid.Row="1" Style="{StaticResource ActivityBar}" Height="6" Margin="0,0,0,10" IsIndeterminate="{Binding IsChecking}"
                     Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Programas com versão nova -->
            <Grid Margin="0,0,14,0">
                <ListBox ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="Margin" Value="0,0,6,8" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="14" Padding="12,10" Background="{StaticResource GlassBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderBrushSoft}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource PinkCheck}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"                                              AutomationProperties.Name="{Binding Name}" ToolTip="{loc:T 'Selecionar para atualizar em lote'}" />
                                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Margin="10,0" Background="{StaticResource B_33FF4FA3}">
                                        <Grid>
                                            <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding Icon, Converter={StaticResource NullToVis}}" />
                                            <TextBlock Text="{Binding Monogram}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PinkPastelBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding Icon, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SourceText}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="12,0" VerticalAlignment="Center" Width="270">
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}" Text="{loc:T 'Instalada  →  Disponível'}" />
                                        <TextBlock Text="{Binding VersionText}" FontSize="12.5" FontFamily="Consolas" Foreground="{StaticResource PinkPastelBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding VersionText}" />
                                    </StackPanel>
                                    <Button Grid.Column="4" Style="{StaticResource AccentButton}" Content="{Binding ButtonText}" VerticalAlignment="Center"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding UpdateButtonName}"
                                            Command="{Binding DataContext.UpdateOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Style="{StaticResource GlassPanel}" Padding="30,24" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{loc:T 'Tudo em dia por aqui ♡'}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource TextDimBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                                   Text="{loc:T 'O WinGet não encontrou versões novas para os programas que ele reconhece neste PC.'}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Histórico -->
            <Border Grid.Column="1" Style="{StaticResource GlassPanel}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="&#xE81C;" Style="{StaticResource IconText}" FontSize="16" />
                        <TextBlock Text="{loc:T 'Histórico'}" Style="{StaticResource PanelTitle}" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{loc:T 'As instalações e atualizações feitas pelo Maid Installer aparecem aqui.'}" TextWrapping="Wrap"
                               FontSize="12.5" Foreground="{StaticResource TextDimBrush}"
                               Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,6" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrushSoft}" ToolTip="{Binding Message}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding DateText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding VersionText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Border x:Name="Chip" Grid.Column="1" Style="{StaticResource Chip}" Background="{StaticResource B_77E0344A}" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding ResultText}" FontSize="10.5" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsOk}" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource B_5532C878}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Barra de seleção -->
        <Border Grid.Row="3" Style="{StaticResource GlassPanel}" Padding="16,10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SelectionText}" FontSize="14" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Content="{loc:T 'Selecionar todos'}" Command="{Binding SelectAllCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource GhostButton}" Content="{loc:T 'Limpar seleção'}" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource AccentButton}" Content="{loc:T 'Atualizar selecionados'}" Command="{Binding UpdateSelectedCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
